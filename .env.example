# ── Required ─────────────────────────────────────────────
# Get a free key at https://openrouter.ai/keys
# Sign up and create a new API key, then paste it below.
OPENROUTER_API_KEY=sk-or-v1-PASTE-YOUR-KEY-HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/free

# ── Optional: stronger model for strict-JSON demos ───────
# OPENROUTER_STRICT_MODEL=openai/gpt-4o-mini

# ── Optional: embeddings ─────────────────────────────────
# OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# ── Optional: vector store backend ───────────────────────
# VECTOR_STORE=simple   # simple | qdrant | pgvector

# ── Optional: moderation (most free OpenRouter models don't support it) ─
# MODERATION_ENABLED=false

# ── Optional: observability ──────────────────────────────
# ACTUATOR_ENABLED=true

# ── Server ────────────────────────────────────────────────
# SERVER_PORT=8080
